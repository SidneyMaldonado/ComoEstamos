<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComoEstamos.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1A2E6E">

    <Grid>
        <!-- Imagem de fundo cobrindo toda a página -->
        <Image Source="fundo.png"
               Aspect="AspectFill"
               Opacity="1"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <!-- Conteúdo sobre a imagem -->
        <ScrollView>
            <VerticalStackLayout
                Padding="20,40,20,20"
                Spacing="0"
                VerticalOptions="Center">

                <!-- Tabela -->
                <Border x:Name="tabelaBorder"
                        Stroke="#FFD700"
                        StrokeThickness="2"
                        BackgroundColor="#1A2E6E"
                        Padding="0"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- Linha 0: Cabeçalho -->
                        <Label Grid.Row="0" Grid.Column="0" Text="Como Estamos" FontAttributes="Bold" FontSize="19" TextColor="White" Padding="18,14,10,14" />
                        <Label x:Name="lblData" Grid.Row="0" Grid.Column="1" FontAttributes="Bold" FontSize="19" TextColor="#FFD700" Padding="10,14,18,14" HorizontalTextAlignment="End" />
                        <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#FFD700" HeightRequest="1.5" VerticalOptions="End" />

                        <!-- Linha 1 -->
                        <Label Grid.Row="1" Grid.Column="0" Text="BB Conta Corrente" FontSize="17" TextColor="#B0C4DE" Padding="18,11,10,11" />
                        <Label x:Name="lblBBCC" Grid.Row="1" Grid.Column="1" FontSize="17" Padding="10,11,18,11" HorizontalTextAlignment="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnValorTapped" CommandParameter="bbCC" />
                            </Label.GestureRecognizers>
                        </Label>
                        <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#2A3F80" HeightRequest="1" VerticalOptions="End" />

                        <!-- Linha 2 -->
                        <Label Grid.Row="2" Grid.Column="0" Text="BB Poupança" FontSize="17" TextColor="#B0C4DE" Padding="18,11,10,11" />
                        <Label x:Name="lblBBPoup" Grid.Row="2" Grid.Column="1" FontSize="17" Padding="10,11,18,11" HorizontalTextAlignment="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnValorTapped" CommandParameter="bbPoup" />
                            </Label.GestureRecognizers>
                        </Label>
                        <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#2A3F80" HeightRequest="1" VerticalOptions="End" />

                        <!-- Linha 3 -->
                        <Label Grid.Row="3" Grid.Column="0" Text="Nubank" FontSize="17" TextColor="#B0C4DE" Padding="18,11,10,11" />
                        <Label x:Name="lblNubank" Grid.Row="3" Grid.Column="1" FontSize="17" Padding="10,11,18,11" HorizontalTextAlignment="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnValorTapped" CommandParameter="nubank" />
                            </Label.GestureRecognizers>
                        </Label>
                        <BoxView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#2A3F80" HeightRequest="1" VerticalOptions="End" />

                        <!-- Linha 4 -->
                        <Label Grid.Row="4" Grid.Column="0" Text="Pagbank" FontSize="17" TextColor="#B0C4DE" Padding="18,11,10,11" />
                        <Label x:Name="lblPagbank" Grid.Row="4" Grid.Column="1" FontSize="17" Padding="10,11,18,11" HorizontalTextAlignment="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnValorTapped" CommandParameter="pagbank" />
                            </Label.GestureRecognizers>
                        </Label>
                        <BoxView Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#2A3F80" HeightRequest="1" VerticalOptions="End" />

                        <!-- Linha 5 -->
                        <Label Grid.Row="5" Grid.Column="0" Text="Infinity" FontSize="17" TextColor="#B0C4DE" Padding="18,11,10,11" />
                        <Label x:Name="lblInfinity" Grid.Row="5" Grid.Column="1" FontSize="17" Padding="10,11,18,11" HorizontalTextAlignment="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnValorTapped" CommandParameter="infinity" />
                            </Label.GestureRecognizers>
                        </Label>
                        <BoxView Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#2A3F80" HeightRequest="1" VerticalOptions="End" />

                        <!-- Linha 6 -->
                        <Label Grid.Row="6" Grid.Column="0" Text="Itaú" FontSize="17" TextColor="#B0C4DE" Padding="18,11,10,11" />
                        <Label x:Name="lblItau" Grid.Row="6" Grid.Column="1" FontSize="17" Padding="10,11,18,11" HorizontalTextAlignment="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnValorTapped" CommandParameter="itau" />
                            </Label.GestureRecognizers>
                        </Label>
                        <BoxView Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#FFD700" HeightRequest="1.5" VerticalOptions="End" />

                        <!-- Linha 7: Total (calculado) -->
                        <Label Grid.Row="7" Grid.Column="0" Text="Total" FontAttributes="Bold" FontSize="18" TextColor="White" Padding="18,12,10,12" />
                        <Label x:Name="lblTotal" Grid.Row="7" Grid.Column="1" FontAttributes="Bold" FontSize="18" TextColor="#7CFC00" Padding="10,12,18,12" HorizontalTextAlignment="End" />
                        <BoxView Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#2A3F80" HeightRequest="1" VerticalOptions="End" />

                        <!-- Linha 8: Falta Pagar -->
                        <Label Grid.Row="8" Grid.Column="0" Text="Falta Pagar" FontSize="17" TextColor="#B0C4DE" Padding="18,11,10,11" />
                        <Label x:Name="lblFaltaPagar" Grid.Row="8" Grid.Column="1" FontSize="17" Padding="10,11,18,11" HorizontalTextAlignment="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnValorTapped" CommandParameter="faltaPagar" />
                            </Label.GestureRecognizers>
                        </Label>
                        <BoxView Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#FFD700" HeightRequest="1.5" VerticalOptions="End" />

                        <!-- Linha 9: Saldo (calculado) -->
                        <Label Grid.Row="9" Grid.Column="0" Text="Saldo" FontAttributes="Bold" FontSize="19" TextColor="White" Padding="18,14,10,14" />
                        <Label x:Name="lblSaldo" Grid.Row="9" Grid.Column="1" FontAttributes="Bold" FontSize="19" TextColor="#FFD700" Padding="10,14,18,14" HorizontalTextAlignment="End" />

                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botões no canto superior direito -->
        <HorizontalStackLayout
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="0,8,8,0"
            Spacing="4">

            <Button ImageSource="contas_icon.png"
                    BackgroundColor="Transparent"
                    BorderColor="Transparent"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Clicked="OnContasClicked" />

            <Button x:Name="btnCompartilhar"
                    ImageSource="share_icon.png"
                    BackgroundColor="Transparent"
                    BorderColor="Transparent"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Clicked="OnCompartilharClicked" />

        </HorizontalStackLayout>

        <!-- Painel de edição sobreposto -->
        <Grid x:Name="painelEdicao"
              IsVisible="False"
              BackgroundColor="#AA000020">
            <Border BackgroundColor="#1A2E6E"
                    Stroke="#FFD700"
                    StrokeThickness="2"
                    Padding="24,20"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    Margin="30,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <Label x:Name="lblTituloEdicao"
                           FontAttributes="Bold"
                           FontSize="17"
                           TextColor="#FFD700"
                           HorizontalTextAlignment="Center" />
                    <Entry x:Name="entryValor"
                           Keyboard="Numeric"
                           FontSize="20"
                           TextColor="White"
                           BackgroundColor="#2A3F80"
                           PlaceholderColor="#7A8FBD"
                           Placeholder="0,00"
                           HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Cancelar"
                                BackgroundColor="#2A3F80"
                                TextColor="White"
                                FontSize="16"
                                CornerRadius="8"
                                Clicked="OnCancelarClicked" />
                        <Button x:Name="btnConfirmar"
                                Grid.Column="1"
                                Text="Confirmar"
                                BackgroundColor="#FFD700"
                                TextColor="#1A2E6E"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="8"
                                Clicked="OnConfirmarClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
