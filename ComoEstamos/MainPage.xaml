<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ComoEstamos.Controls"
             x:Class="ComoEstamos.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AzulFundo}">

    <Grid>
        <Image Source="fundo.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
              Padding="20,50,20,20"
              RowSpacing="16">

            <!-- Atalho: arrastar o dedo para cima abre as dívidas. As linhas da tabela continuam rolando. -->
            <Grid.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Up" Swiped="ArrastarParaCima_Swiped" />
            </Grid.GestureRecognizers>

            <!-- Título -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <ImageButton Style="{StaticResource BotaoMenu}" Clicked="Menu_Clicked" />
                <Label Grid.Column="1"
                       Text="Como Estamos"
                       Style="{StaticResource TituloPagina}" />
                <!-- Compartilhar: gera a imagem da tabela de saldos e abre o compartilhamento do sistema -->
                <Border x:Name="BotaoCompartilhar"
                        Grid.Column="2"
                        Style="{StaticResource BotaoCirculo}"
                        SemanticProperties.Description="Compartilhar saldos">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Compartilhar_Tapped" />
                    </Border.GestureRecognizers>
                    <Image Source="share_icon.png" Style="{StaticResource IconeCirculo}" />
                </Border>
            </Grid>

            <BoxView Grid.Row="1"
                     HeightRequest="2"
                     BackgroundColor="{StaticResource Dourado}" />

            <!-- Tabela de contas -->
            <controls:TabelaRegistros x:Name="Tabela"
                                   Grid.Row="2"
                                   TituloTexto="Conta"
                                   TituloValor="Saldo"
                                   MensagemVazia="Nenhuma conta cadastrada." />

            <Button Grid.Row="3"
                    Text="Atualizar Saldos"
                    Style="{StaticResource BotaoPrincipal}"
                    Clicked="AtualizarSaldos_Clicked" />

            <!-- Dica do atalho; tocar também abre as dívidas (no Windows, o arrasto com o mouse não dispara o gesto). -->
            <Label Grid.Row="4"
                   Text="︿  Arraste para cima para ver as dívidas"
                   FontSize="12"
                   TextColor="{StaticResource Dourado}"
                   Opacity="0.8"
                   HorizontalTextAlignment="Center"
                   Margin="0,-8,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Dividas_Tapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Grid>

</ContentPage>
