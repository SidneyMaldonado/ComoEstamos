<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComoEstamos.Pages.Parcelas.VisualizarParcelaPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AzulFundo}">

    <Grid>
        <Image Source="fundo.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <ScrollView>
            <VerticalStackLayout Style="{StaticResource ConteudoFormulario}">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <Label Text="Parcela" Style="{StaticResource TituloPagina}" />
                    <!-- Alterar e excluir: só parcelas em aberto. Na paga, os dois ficam apagados. -->
                    <Border x:Name="BotaoAlterar"
                            Grid.Column="1"
                            Style="{StaticResource BotaoCirculo}"
                            SemanticProperties.Description="Alterar parcela">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Alterar_Tapped" />
                        </Border.GestureRecognizers>
                        <Image Source="editar_icon.png" Style="{StaticResource IconeCirculo}" />
                    </Border>
                    <Border x:Name="BotaoExcluir"
                            Grid.Column="2"
                            Style="{StaticResource BotaoCirculo}"
                            SemanticProperties.Description="Excluir parcela">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Excluir_Tapped" />
                        </Border.GestureRecognizers>
                        <Image Source="lixeira_icon.png" Style="{StaticResource IconeCirculo}" />
                    </Border>
                </Grid>

                <BoxView Style="{StaticResource LinhaTitulo}" />

                <Border Style="{StaticResource Cartao}" Padding="16,14">
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="12">

                        <Label x:Name="TituloDivida" Text="Dívida" Style="{StaticResource TituloCampo}" />
                        <Label x:Name="ValorDivida" Grid.Row="1" Style="{StaticResource ValorCampo}" />
                        <Label Grid.Column="1" Text="Parcela" Style="{StaticResource TituloCampo}" />
                        <Label x:Name="ValorNumero" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValorCampo}" />

                        <Label Grid.Row="2" Text="Valor" Style="{StaticResource TituloCampoSeguinte}" />
                        <Label x:Name="ValorValor" Grid.Row="3" Style="{StaticResource ValorCampo}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Vencimento" Style="{StaticResource TituloCampoSeguinte}" />
                        <Label x:Name="ValorVencimento" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValorCampo}" />

                        <Label Grid.Row="4" Text="Situação" Style="{StaticResource TituloCampoSeguinte}" />
                        <Label x:Name="ValorSituacao" Grid.Row="5" Style="{StaticResource ValorCampo}" />
                        <Label x:Name="TituloDataPagamento" Grid.Row="4" Grid.Column="1" Text="Data do Pagamento" Style="{StaticResource TituloCampoSeguinte}" />
                        <Label x:Name="ValorDataPagamento" Grid.Row="5" Grid.Column="1" Style="{StaticResource ValorCampo}" />

                        <Label Grid.Row="6" Text="Conta" Style="{StaticResource TituloCampoSeguinte}" />
                        <Label x:Name="ValorConta" Grid.Row="7" Style="{StaticResource ValorCampo}" />
                        <Label Grid.Row="6" Grid.Column="1" Text="Categoria" Style="{StaticResource TituloCampoSeguinte}" />
                        <Label x:Name="ValorCategoria" Grid.Row="7" Grid.Column="1" Style="{StaticResource ValorCampo}" />

                        <Label Grid.Row="8" Grid.ColumnSpan="2" Text="Descrição" Style="{StaticResource TituloCampoSeguinte}" />
                        <Label x:Name="ValorDescricao" Grid.Row="9" Grid.ColumnSpan="2" Style="{StaticResource ValorCampo}" />

                        <Label Grid.Row="10" Text="Data de Cadastro" Style="{StaticResource TituloCampoSeguinte}" />
                        <Label x:Name="ValorDataCriacao" Grid.Row="11" Style="{StaticResource ValorCampo}" />
                        <Label Grid.Row="10" Grid.Column="1" Text="Última Alteração" Style="{StaticResource TituloCampoSeguinte}" />
                        <Label x:Name="ValorDataAlteracao" Grid.Row="11" Grid.Column="1" Style="{StaticResource ValorCampo}" />

                    </Grid>
                </Border>

                <!-- Pagamento (na receita, recebimento): só aparece na parcela em aberto -->
                <Border x:Name="CartaoPagar" Style="{StaticResource Cartao}" IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="TituloCampoDataPagamento" Text="Data do Pagamento" Style="{StaticResource TituloCampo}" />
                        <DatePicker x:Name="CampoDataPagamento" Style="{StaticResource CampoData}" />
                        <Label x:Name="ErroDataPagamento" Style="{StaticResource MensagemErro}" />
                        <Button x:Name="BotaoPagar"
                                Text="Pagar"
                                Style="{StaticResource BotaoPrincipal}"
                                Clicked="Pagar_Clicked" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Voltar"
                        Style="{StaticResource BotaoSecundario}"
                        Clicked="Voltar_Clicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
