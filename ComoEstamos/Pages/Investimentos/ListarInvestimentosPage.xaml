<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ComoEstamos.Controls"
             x:Class="ComoEstamos.Pages.Investimentos.ListarInvestimentosPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AzulFundo}">

    <Grid>
        <Image Source="fundo.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid RowDefinitions="Auto,Auto,*" Style="{StaticResource Conteudo}">

            <!-- Atalho: arrastar o dedo para cima volta para a tela inicial (o contrário do atalho da MainPage).
                 As linhas da tabela continuam rolando. -->
            <Grid.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Up" Swiped="ArrastarParaCima_Swiped" />
            </Grid.GestureRecognizers>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <ImageButton Style="{StaticResource BotaoMenu}" Clicked="Menu_Clicked" />
                <Label Grid.Column="1"
                       Text="Investimentos"
                       Style="{StaticResource TituloPagina}" />
                <Border Grid.Column="2"
                        Style="{StaticResource BotaoCirculo}"
                        SemanticProperties.Description="Incluir investimento">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Incluir_Tapped" />
                    </Border.GestureRecognizers>
                    <Label Style="{StaticResource SinalMais}" />
                </Border>
            </Grid>

            <BoxView Grid.Row="1" Style="{StaticResource LinhaTitulo}" />

            <controls:TabelaRegistros x:Name="Tabela"
                                   Grid.Row="2"
                                   TituloTexto="Investimento"
                                   TituloValor="Valor"
                                   MensagemVazia="Nenhum investimento cadastrado."
                                   LinhaTocada="Tabela_LinhaTocada" />
        </Grid>
    </Grid>

</ContentPage>
