<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ComoEstamos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ComoEstamos"
    xmlns:carteiras="clr-namespace:ComoEstamos.Pages.Carteiras"
    xmlns:categorias="clr-namespace:ComoEstamos.Pages.Categorias"
    xmlns:contas="clr-namespace:ComoEstamos.Pages.Contas"
    xmlns:credores="clr-namespace:ComoEstamos.Pages.Credores"
    xmlns:dividas="clr-namespace:ComoEstamos.Pages.Dividas"
    xmlns:investimentos="clr-namespace:ComoEstamos.Pages.Investimentos"
    xmlns:receitas="clr-namespace:ComoEstamos.Pages.Receitas"
    xmlns:resumo="clr-namespace:ComoEstamos.Pages.Resumo"
    Shell.BackgroundColor="#1A2E6E"
    Shell.FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{StaticResource AzulEscuro}"
    Title="ComoEstamos">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,40,20,16" Spacing="12">
            <Label Text="Como Estamos"
                   FontFamily="OpenSansSemibold"
                   FontSize="24"
                   TextColor="{StaticResource Dourado}" />
            <BoxView HeightRequest="2" BackgroundColor="{StaticResource Dourado}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="20,14">
                <Image Source="{Binding FlyoutIcon}" WidthRequest="24" HeightRequest="24" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="17"
                       TextColor="{StaticResource TextoClaro}"
                       VerticalTextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem Title="Início" Icon="inicio_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Resumo do Mês" Icon="resumo_icon.png">
        <ShellContent ContentTemplate="{DataTemplate resumo:ResumoMesPage}" Route="resumo" />
    </FlyoutItem>

    <FlyoutItem Title="Contas" Icon="contas_icon.png">
        <ShellContent ContentTemplate="{DataTemplate contas:ListarContasPage}" Route="contas" />
    </FlyoutItem>

    <FlyoutItem Title="Dívidas" Icon="divida_icon.png">
        <ShellContent ContentTemplate="{DataTemplate dividas:ListarDividasPage}" Route="dividas" />
    </FlyoutItem>

    <FlyoutItem Title="Receitas" Icon="receita_icon.png">
        <ShellContent ContentTemplate="{DataTemplate receitas:ListarReceitasPage}" Route="receitas" />
    </FlyoutItem>

    <FlyoutItem Title="Categorias" Icon="categoria_icon.png">
        <ShellContent ContentTemplate="{DataTemplate categorias:ListarCategoriasPage}" Route="categorias" />
    </FlyoutItem>

    <FlyoutItem Title="Credores" Icon="credor_icon.png">
        <ShellContent ContentTemplate="{DataTemplate credores:ListarCredoresPage}" Route="credores" />
    </FlyoutItem>

    <FlyoutItem Title="Carteiras" Icon="carteira_icon.png">
        <ShellContent ContentTemplate="{DataTemplate carteiras:ListarCarteirasPage}" Route="carteiras" />
    </FlyoutItem>

    <FlyoutItem Title="Investimentos" Icon="investimento_icon.png">
        <ShellContent ContentTemplate="{DataTemplate investimentos:ListarInvestimentosPage}" Route="investimentos" />
    </FlyoutItem>

</Shell>
